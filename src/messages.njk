<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Messages — Dr. Imaobong Odutola</title>
<meta name="description" content="Full-length messages on purpose, the Holy Spirit, the anointing and the revelation of Jesus Christ.">
<link rel="icon" href="assets/brand/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav">
    <a class="nav__logo" href="index.html" aria-label="Dr. Imaobong Odutola — home">
      <img src="assets/brand/logo.png" alt="Imaobong Odutola">
    </a>
    <nav aria-label="Primary">
      <ul class="nav__links">
      <li><a href="index.html">Home</a></li>
      <li><a href="about.html">About</a></li>
      <li><a href="messages.html">Messages</a></li>
      <li><a href="coaching.html">Coaching</a></li>
      <li><a href="store.html">Store</a></li>
      <li><a href="speaking.html">Speaker Request</a></li>
      <li><a href="https://lightandgraceministry.org/" target="_blank" rel="noopener">Light and Grace Ministries</a></li>
      </ul>
    </nav>
    <button class="nav__toggle" type="button" aria-expanded="false"
            aria-controls="drawer" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <div class="drawer" id="drawer" data-open="false">
    <a href="index.html">Home</a>
    <a href="about.html">About</a>
    <a href="messages.html">Messages</a>
    <a href="coaching.html">Coaching</a>
    <a href="store.html">Store</a>
    <a href="speaking.html">Speaker Request</a>
    <a href="https://lightandgraceministry.org/" target="_blank" rel="noopener">Light and Grace Ministries</a>
  </div>

  <main id="main">
    <section class="page-head">
      <span class="watermark" aria-hidden="true">IO</span>
      <div class="shell" style="position:relative;z-index:1">
        <span class="eyebrow">Messages</span>
        <h1>Teaching that awakens the believer</h1>
        <p class="lead">Full-length messages on purpose, the Holy Spirit, the anointing
           and the revelation of Jesus Christ. Press play to watch on YouTube.</p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="shell">
        <div class="messages">
        {%- for m in resolved.messages %}
        <article class="message" data-reveal>
          <div class="yt" data-yt="{{ m.youtubeId }}" data-yt-title="{{ m.title }}" role="button" tabindex="0">
            <img src="{{ m.thumbnail }}" alt="Dr. Imaobong Odutola preaching" loading="lazy">
            <span class="yt__play" aria-hidden="true"></span>
          </div>
          <div>
            {%- if m.subtitle %}
            <span class="eyebrow">{{ m.subtitle }}</span>
            {%- endif %}
            <h3>{{ m.title }}</h3>
            {%- for p in m.paragraphs %}
            <p>{{ p }}</p>
            {%- endfor %}
          </div>
        </article>
        {%- endfor %}
        </div>
      </div>
    </section>

    <section class="band">
      <img class="band__bg" src="assets/img/feature/crowd-crusade.jpg" alt="" loading="lazy">
      <div class="band__inner">
        <div class="shell">
          <span class="eyebrow">Invite her</span>
          <h2>Bring this teaching to your church or conference</h2>
          <div class="btn-row">
            <a class="btn btn--on-dark" href="speaking.html">Speaker request form</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  {% include "footer.njk" %}

  <script src="assets/js/main.js" defer></script>
</body>
</html>
