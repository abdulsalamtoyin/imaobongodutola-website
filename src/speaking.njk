<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Speaker request — Dr. Imaobong Odutola</title>
<meta name="description" content="Invite Dr. Imaobong Odutola to minister at your conference, crusade or gathering.">
<link rel="icon" href="assets/brand/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav">
    <a class="nav__logo" href="index.html" aria-label="Dr. Imaobong Odutola — home">
      <img src="assets/brand/logo.png" alt="Imaobong Odutola">
    </a>
    <nav aria-label="Primary">
      <ul class="nav__links">
      <li><a href="index.html">Home</a></li>
      <li><a href="about.html">About</a></li>
      <li><a href="messages.html">Messages</a></li>
      <li><a href="coaching.html">Coaching</a></li>
      <li><a href="store.html">Store</a></li>
      <li><a href="speaking.html">Speaker Request</a></li>
      <li><a href="https://lightandgraceministry.org/" target="_blank" rel="noopener">Light and Grace Ministries</a></li>
      </ul>
    </nav>
    <button class="nav__toggle" type="button" aria-expanded="false"
            aria-controls="drawer" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <div class="drawer" id="drawer" data-open="false">
    <a href="index.html">Home</a>
    <a href="about.html">About</a>
    <a href="messages.html">Messages</a>
    <a href="coaching.html">Coaching</a>
    <a href="store.html">Store</a>
    <a href="speaking.html">Speaker Request</a>
    <a href="https://lightandgraceministry.org/" target="_blank" rel="noopener">Light and Grace Ministries</a>
  </div>

  <main id="main">
    <section class="page-head">
      <span class="watermark" aria-hidden="true">IO</span>
      <div class="shell" style="position:relative;z-index:1">
        <span class="eyebrow">Speaker request</span>
        <h1>Speaker request form</h1>
        <p class="lead">Dr. Imaobong ministers at revival gatherings, conferences,
           crusades and women’s gatherings across the world. Tell her about yours and
           she will come back to you.</p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="shell">
        <div class="rail">
          <span class="eyebrow">Request form</span>
          <div>
            <form class="form" name="speaker-request" method="POST" data-netlify="true">
              <input type="hidden" name="form-name" value="speaker-request">
              <div class="field-row">
                <div class="field">
                  <label for="sp-name">Your name</label>
                  <input id="sp-name" name="name" type="text" required>
                </div>
                <div class="field">
                  <label for="sp-org">Church or organisation</label>
                  <input id="sp-org" name="organisation" type="text" required>
                </div>
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="sp-email">Email address</label>
                  <input id="sp-email" name="email" type="email" required>
                </div>
                <div class="field">
                  <label for="sp-phone">Phone</label>
                  <input id="sp-phone" name="phone" type="tel">
                </div>
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="sp-date">Date of the event</label>
                  <input id="sp-date" name="event_date" type="date">
                </div>
                <div class="field">
                  <label for="sp-location">Location</label>
                  <input id="sp-location" name="location" type="text"
                         placeholder="City, country">
                </div>
              </div>
              <div class="field">
                <label for="sp-type">Type of gathering</label>
                <select id="sp-type" name="event_type">
                  <option>Revival gathering</option>
                  <option>Conference</option>
                  <option>Crusade</option>
                  <option>Women’s gathering</option>
                  <option>Church service</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="field">
                <label for="sp-details">Tell her about the gathering</label>
                <textarea id="sp-details" name="details"
                          placeholder="Expected attendance, theme, and what you are believing God for."></textarea>
              </div>
              <button class="btn" type="submit">Send request</button>
              <p class="field__hint" style="margin-top:1.25rem">
                She will reply by email. You can also write directly to
                <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>.
              </p>
            </form>

            <div class="todo">
              <strong>Waiting on the new address</strong>
              Requests go to the site’s Netlify Forms inbox and are forwarded to
              {{ contact.email }} for now. Imaobong is creating a dedicated
              address — when it exists, swap it here and in the footer (the README
              has the one-line command) and update the forwarding address in
              Netlify under Forms → Notifications.
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  {% include "footer.njk" %}

  <script src="assets/js/main.js" defer></script>
</body>
</html>
