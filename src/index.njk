<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dr. Imaobong Odutola — Apostle, Purpose Coach, Author</title>
<meta name="description" content="Dr. Imaobong Odutola is a trained Medical Doctor called to be an Apostle of Jesus Christ, raising disciples and leading believers into their divine purpose.">
<link rel="icon" href="assets/brand/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body data-transparent-nav>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav">
    <a class="nav__logo" href="index.html" aria-label="Dr. Imaobong Odutola — home">
      <img src="assets/brand/logo.png" alt="Imaobong Odutola">
    </a>
    <nav aria-label="Primary">
      <ul class="nav__links">
      <li><a href="index.html">Home</a></li>
      <li><a href="about.html">About</a></li>
      <li><a href="messages.html">Messages</a></li>
      <li><a href="coaching.html">Coaching</a></li>
      <li><a href="store.html">Store</a></li>
      <li><a href="speaking.html">Speaker Request</a></li>
      <li><a href="https://lightandgraceministry.org/" target="_blank" rel="noopener">Light and Grace Ministries</a></li>
      </ul>
    </nav>
    <button class="nav__toggle" type="button" aria-expanded="false"
            aria-controls="drawer" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <div class="drawer" id="drawer" data-open="false">
    <a href="index.html">Home</a>
    <a href="about.html">About</a>
    <a href="messages.html">Messages</a>
    <a href="coaching.html">Coaching</a>
    <a href="store.html">Store</a>
    <a href="speaking.html">Speaker Request</a>
    <a href="https://lightandgraceministry.org/" target="_blank" rel="noopener">Light and Grace Ministries</a>
  </div>

  <main id="main">
    <section class="hero">
      <div class="hero__media">
        <!-- Rotation order is deliberate, not filename order. On phones only the
             first four load (see main.js), so the four brightest and most varied
             clips lead. hero-08 was dropped at Imaobong's request; hero-11 to
             hero-13 are the replacements she asked for. -->
        <video class="hero__clip" data-src="assets/video/hero-01.mp4" poster="assets/video/hero-01.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-12.mp4" poster="assets/video/hero-12.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-02.mp4" poster="assets/video/hero-02.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-13.mp4" poster="assets/video/hero-13.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-04.mp4" poster="assets/video/hero-04.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-11.mp4" poster="assets/video/hero-11.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-05.mp4" poster="assets/video/hero-05.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-07.mp4" poster="assets/video/hero-07.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-09.mp4" poster="assets/video/hero-09.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-10.mp4" poster="assets/video/hero-10.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-06.mp4" poster="assets/video/hero-06.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <video class="hero__clip" data-src="assets/video/hero-03.mp4" poster="assets/video/hero-03.jpg" muted playsinline loop preload="none" aria-hidden="true"></video>
        <div class="hero__scrim"></div>
      </div>
      <div class="hero__body">
        <div class="shell">
          <p class="hero__eyebrow">Apostle &middot; Medical Doctor &middot; Purpose Coach &middot; Author</p>
          <h1 class="hero__title">Dr.&nbsp;Imaobong Odutola</h1>
          <blockquote class="hero__quote">
            Life becomes truly meaningful when you discover your purpose in Christ
            and fully surrender to His divine will.
          </blockquote>
          <div class="btn-row">
            <a class="btn btn--on-dark" href="messages.html">Watch her messages</a>
            <a class="btn btn--ghost-on-dark" href="coaching.html">Explore coaching</a>
          </div>
          <div class="hero__dots" role="tablist" aria-label="Choose a clip">
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 1"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 2"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 3"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 4"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 5"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 6"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 7"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 8"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 9"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 10"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 11"></button>
          <button class="hero__dot" type="button" role="tab" aria-selected="false" aria-label="Show clip 12"></button>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="shell">
        <div class="pillars">
          <div class="pillar" data-reveal>
            <h3>Prophetic Prayer &amp; Praise</h3>
            <p>A prophetic prayer movement birthed to awaken intimacy with the Lord
               through fervent prayer, heartfelt worship and deep encounters with the
               Holy Spirit.</p>
          </div>
          <div class="pillar" data-reveal>
            <h3>The Change Woman Global</h3>
            <p>A global movement commissioned to ignite prayer, awaken the power of the
               Holy Spirit, and stir purpose in women through conferences, mentorship
               and prophetic gatherings.</p>
          </div>
          <div class="pillar" data-reveal>
            <h3>Light and Grace Ministries</h3>
            <p>Revival gatherings in cities around the world, preaching the gospel of
               Jesus and awakening believers to the person and ministry of the
               Holy Spirit.</p>
            <p style="margin-top:1rem"><a class="link" href="https://lightandgraceministry.org/" target="_blank" rel="noopener">Visit the ministry</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--band">
      <span class="watermark" aria-hidden="true">IO</span>
      <div class="shell">
        <div class="split" data-reveal>
          <div class="split__media">
            <img src="assets/img/feature/portrait-main.jpg"
                 alt="Dr. Imaobong Odutola" loading="lazy">
          </div>
          <div class="split__body">
            <span class="eyebrow">About</span>
            <h2>An ambassador of Jesus Christ</h2>
            <p class="lead">A trained Medical Doctor, called to be an Apostle of Jesus
               Christ, who has devoted her life to raising disciples for the Kingdom
               of God.</p>
            <p>Her passion for spreading the Gospel was ignited during her high school
               years through a powerful divine encounter with God that marked the
               beginning of her apostolic assignment. Since then she has remained
               committed to impacting lives, transforming destinies, and advancing the
               Kingdom of God through the preaching of the Gospel and the demonstration
               of the power of the Holy Spirit.</p>
            <div class="btn-row"><a class="btn" href="about.html">Read her story</a></div>
          </div>
        </div>
      </div>
    </section>

    {%- if resolved.featuredBook %}{% set fb = resolved.featuredBook %}
    <section class="section">
      <div class="shell">
        <div class="book-feature" data-reveal>
          <div>
            <span class="eyebrow">Featured book</span>
            <h2 style="font-size:var(--t-h2);margin-bottom:1.25rem">{{ fb.title }}</h2>
            <p class="lead">{{ fb.lead }}</p>
            <p>{{ fb.blurb }}</p>
            <div class="btn-row">
              <a class="btn" href="{{ fb.selar_url }}" target="_blank" rel="noopener">Buy on Selar</a>
              <a class="btn btn--ghost" href="store.html">All books</a>
            </div>
          </div>
          <div class="book-cover book-cover--image">
            <img src="{{ fb.cover }}" alt="{{ fb.cover_alt }}" loading="lazy" width="640">
          </div>
        </div>
      </div>
    </section>
    {%- endif %}

    <section class="section section--band">
      <span class="watermark" aria-hidden="true">IO</span>
      <div class="shell">
        <div class="rail" style="margin-bottom:3rem">
          <span class="eyebrow">Messages</span>
          <div>
            <h2 style="font-size:var(--t-h2)">{{ home.messages_heading }}</h2>
          </div>
        </div>
        <div class="messages">
        {%- for m in resolved.homeMessages %}
        <article class="message" data-reveal>
          <div class="yt" data-yt="{{ m.youtubeId }}" data-yt-title="{{ m.title }}" role="button" tabindex="0">
            <img src="{{ m.thumbnail }}" alt="Dr. Imaobong Odutola preaching" loading="lazy">
            <span class="yt__play" aria-hidden="true"></span>
          </div>
          <div>
            <h3>{{ m.title }}</h3>
            {%- if m.paragraphs[0] %}
            <p>{{ m.paragraphs[0] }}</p>
            {%- endif %}
            <a class="link" href="messages.html">Read the full message</a>
          </div>
        </article>
        {%- endfor %}
        </div>
        <div class="btn-row"><a class="btn btn--ghost" href="messages.html">All messages</a></div>
      </div>
    </section>

    <section class="band">
      <img class="band__bg" src="assets/img/feature/band-cross.jpg" alt="" loading="lazy">
      <div class="band__inner">
        <div class="shell">
          <span class="eyebrow">Coaching</span>
          <h2>Discover and fulfil your purpose in Christ</h2>
          <p class="lead">As a certified Purpose Coach, Dr. Imaobong has guided countless
             individuals into discovering their God-given identity, unlocking hidden
             potential, and aligning their lives with Heaven’s agenda.</p>
          <div class="btn-row">
            <a class="btn btn--on-dark" href="coaching.html">About the coaching</a>
            <a class="btn btn--ghost-on-dark" href="https://forms.gle/4sez6N3LM7c8ij7z6" target="_blank" rel="noopener">Register your interest</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="rail" style="margin-bottom:2.5rem">
          <span class="eyebrow">Gallery</span>
          <div><h2 style="font-size:var(--t-h2)">From the gatherings</h2></div>
        </div>
        <div class="gallery" data-reveal>
          <a href="gallery.html" class="gallery__item" style="cursor:pointer"><img src="assets/img/gallery/thumb/g03.jpg" alt="From the gatherings" loading="lazy"></a>
          <a href="gallery.html" class="gallery__item" style="cursor:pointer"><img src="assets/img/gallery/thumb/g18.jpg" alt="From the gatherings" loading="lazy"></a>
          <a href="gallery.html" class="gallery__item" style="cursor:pointer"><img src="assets/img/gallery/thumb/g14.jpg" alt="From the gatherings" loading="lazy"></a>
          <a href="gallery.html" class="gallery__item" style="cursor:pointer"><img src="assets/img/gallery/thumb/g09.jpg" alt="From the gatherings" loading="lazy"></a>
          <a href="gallery.html" class="gallery__item" style="cursor:pointer"><img src="assets/img/gallery/thumb/g21.jpg" alt="From the gatherings" loading="lazy"></a>
          <a href="gallery.html" class="gallery__item" style="cursor:pointer"><img src="assets/img/gallery/thumb/g06.jpg" alt="From the gatherings" loading="lazy"></a>
        </div>
        <div class="btn-row"><a class="btn btn--ghost" href="gallery.html">View the full gallery</a></div>
      </div>
    </section>

    <section class="section section--band" id="testimonies">
      <span class="watermark" aria-hidden="true">IO</span>
      <div class="shell">
        <div class="rail" style="margin-bottom:3rem">
          <span class="eyebrow">Testimonies</span>
          <div>
            <h2 style="font-size:var(--t-h2)">What the Lord has done</h2>
            <p class="lead">Testimonies from believers who have encountered God
               through these gatherings — and room for you to add yours.</p>
          </div>
        </div>

        <div class="testify">
          <div class="testify__list" data-reveal>
            <div class="todo" style="margin-top:0">
              <strong>Needed from Imaobong</strong>
              Three or four real testimonies — the words, the person’s first name,
              and their city. The cards below are built and waiting; nothing here is
              written by us, because a testimony has to be someone’s own.
            </div>
            <figure class="testimonial testimonial--empty">
              <blockquote>Testimony to come</blockquote>
              <figcaption><span class="testimonial__note">Awaiting her words</span></figcaption>
            </figure>
            <figure class="testimonial testimonial--empty">
              <blockquote>Testimony to come</blockquote>
              <figcaption><span class="testimonial__note">Awaiting her words</span></figcaption>
            </figure>
            <figure class="testimonial testimonial--empty">
              <blockquote>Testimony to come</blockquote>
              <figcaption><span class="testimonial__note">Awaiting her words</span></figcaption>
            </figure>
          </div>

          <aside class="testify__share" data-reveal>
            <h3>Share your testimony</h3>
            <p>Has God met you through one of these gatherings, a message or the
               coaching? Tell her about it. With your permission it may be shared
               here to strengthen someone else’s faith.</p>
            <form class="form" name="testimony" method="POST" data-netlify="true">
              <input type="hidden" name="form-name" value="testimony">
              <div class="field">
                <label for="ts-name">Your name</label>
                <input id="ts-name" name="name" type="text" required>
              </div>
              <div class="field">
                <label for="ts-location">City and country</label>
                <input id="ts-location" name="location" type="text" placeholder="Brisbane, Australia">
              </div>
              <div class="field">
                <label for="ts-email">Email address</label>
                <input id="ts-email" name="email" type="email" required>
                <p class="field__hint">Never published — only so she can reply to you.</p>
              </div>
              <div class="field">
                <label for="ts-story">Your testimony</label>
                <textarea id="ts-story" name="testimony" required
                          placeholder="Tell her what God did."></textarea>
              </div>
              <label class="field-check">
                <input type="checkbox" name="consent" value="yes">
                <span>You may share my testimony on this website, with my first
                      name and city.</span>
              </label>
              <button class="btn" type="submit">Send my testimony</button>
            </form>
          </aside>
        </div>
      </div>
    </section>

    <section class="section section--ink">
      <span class="watermark" aria-hidden="true">IO</span>
      <div class="shell">
        <div class="rail">
          <span class="eyebrow">Stay close</span>
          <div>
            <h2 style="font-size:var(--t-h2);margin-bottom:1.25rem">Receive her teachings by email</h2>
            <p class="lead">Devotionals, message releases and gathering announcements.</p>
            <form class="form" name="newsletter" method="POST" data-netlify="true"
                  style="margin-top:2rem">
              <input type="hidden" name="form-name" value="newsletter">
              <div class="field">
                <label for="nl-email" style="color:rgba(255,255,255,0.6)">Email address</label>
                <input id="nl-email" name="email" type="email" required
                       style="color:#fff;border-bottom-color:rgba(255,255,255,0.35)">
              </div>
              <button class="btn btn--on-dark" type="submit">Subscribe</button>
            </form>
            <div class="todo" style="background:rgba(185,138,70,0.14);margin-top:2rem">
              <strong>To confirm with Imaobong</strong>
              Does she want a newsletter, and which provider should it feed
              (Mailchimp, Netlify notifications, or something else)? Until that is
              decided this form stores submissions in Netlify only.
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  {% include "footer.njk" %}

  <script src="assets/js/main.js" defer></script>
</body>
</html>
